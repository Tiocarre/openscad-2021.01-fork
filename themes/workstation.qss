QWidget {
    background-color: #101419;
    color: #d4dbe3;
    font-family: "Consolas", "Cascadia Mono", monospace;
    font-size: 9pt;
}

QMainWindow::separator {
    background: #27313b;
    width: 1px;
    height: 1px;
}

QMenuBar {
    background-color: #11171d;
    border-bottom: 1px solid #27313b;
    padding: 3px 5px;
}
QMenuBar::item {
    background: transparent;
    padding: 5px 8px;
}
QMenuBar::item:selected, QMenu::item:selected {
    background-color: #263440;
    color: #e6edf3;
}
QMenu {
    background-color: #151b22;
    border: 1px solid #303b46;
    padding: 4px;
}
QMenu::item {
    padding: 5px 22px 5px 10px;
}
QMenu::separator {
    height: 1px;
    background: #29343f;
    margin: 4px 6px;
}

QToolBar {
    background-color: #141a20;
    border: 0;
    border-bottom: 1px solid #27313b;
    spacing: 3px;
    padding: 3px;
}
QToolBar::separator {
    background: #303b46;
    width: 1px;
    margin: 3px 5px;
}
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    padding: 4px;
}
QToolButton:hover, QToolButton:checked {
    background-color: #202c36;
    border-color: #354653;
}

QDockWidget::title {
    background-color: #151b22;
    border-bottom: 1px solid #303b46;
    padding: 6px 8px;
    text-align: left;
}
QTabBar::tab {
    background: #151b22;
    border: 1px solid #29343f;
    padding: 6px 10px;
}
QTabBar::tab:selected {
    background: #1b242d;
    color: #e6edf3;
    border-bottom-color: #71b7a2;
}

QPlainTextEdit, QTextEdit, QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox,
QListWidget, QTreeWidget, QTableWidget, QTableView {
    background-color: #0d1217;
    alternate-background-color: #111820;
    border: 1px solid #2b3641;
    selection-background-color: #29443f;
    selection-color: #e6edf3;
    padding: 4px;
}
QComboBox::drop-down {
    border: 0;
    width: 20px;
}
QHeaderView::section {
    background-color: #171e25;
    border: 0;
    border-right: 1px solid #2b3641;
    border-bottom: 1px solid #2b3641;
    padding: 5px 7px;
}

QPushButton {
    background-color: #1a222a;
    border: 1px solid #35414d;
    padding: 5px 10px;
}
QPushButton:hover, QToolButton:hover {
    background-color: #23313b;
}
QPushButton:pressed {
    background-color: #29443f;
}
QPushButton:disabled, QLineEdit:disabled {
    color: #727e89;
    background-color: #141a20;
    border-color: #252e37;
}

QScrollBar:vertical {
    background: #11171d;
    width: 11px;
    margin: 0;
}
QScrollBar:horizontal {
    background: #11171d;
    height: 11px;
    margin: 0;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #394550;
    min-height: 24px;
    min-width: 24px;
}
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
    border: 0;
}

QStatusBar {
    background-color: #11171d;
    border-top: 1px solid #27313b;
}
QStatusBar::item {
    border: 0;
}

QLabel#assistantEyebrow {
    color: #8d9aa6;
    font-weight: bold;
    letter-spacing: 1px;
}
QLabel#assistantStatus {
    color: #d6a66e;
    border-bottom: 1px solid #2b3641;
    padding-bottom: 8px;
}
QLabel#assistantHistory {
    color: #87939e;
    border: 1px solid #27313b;
    padding: 10px;
}
QLabel#assistantContext {
    color: #a5b0ba;
    background-color: #151c23;
    border: 1px solid #2b3641;
    padding: 8px;
}
QPushButton#assistantSend {
    color: #8fa99f;
    border-color: #364b45;
}
