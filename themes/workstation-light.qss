QWidget {
    background-color: #f5f3f5;
    color: #29242a;
    font-family: "Consolas", "Cascadia Mono", monospace;
    font-size: 9pt;
}

QMainWindow::separator {
    background: #d5cfd5;
    width: 1px;
    height: 1px;
}

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #ded8de;
    padding: 3px 5px;
}
QMenuBar::item {
    background: transparent;
    padding: 5px 8px;
}
QMenuBar::item:selected, QMenu::item:selected {
    background-color: #f3d8e4;
    color: #4a1830;
}
QMenu {
    background-color: #ffffff;
    border: 1px solid #d8cdd4;
    padding: 4px;
}
QMenu::item {
    padding: 5px 22px 5px 10px;
}
QMenu::separator {
    height: 1px;
    background: #e3dce1;
    margin: 4px 6px;
}

QToolBar {
    background-color: #ffffff;
    border: 0;
    border-bottom: 1px solid #ded8de;
    spacing: 3px;
    padding: 3px;
}
QToolBar::separator {
    background: #d8cdd4;
    width: 1px;
    margin: 3px 5px;
}
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    padding: 4px;
}
QToolButton:hover, QToolButton:checked {
    background-color: #f8e8ef;
    border-color: #d9a9bd;
}

QDockWidget::title {
    background-color: #eee9ed;
    border-bottom: 1px solid #d8cdd4;
    padding: 6px 8px;
    text-align: left;
}
QTabBar::tab {
    background: #eee9ed;
    border: 1px solid #ded8de;
    padding: 6px 10px;
}
QTabBar::tab:selected {
    background: #ffffff;
    color: #3a2630;
    border-bottom-color: #c2185b;
}

QPlainTextEdit, QTextEdit, QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox,
QListWidget, QTreeWidget, QTableWidget, QTableView {
    background-color: #ffffff;
    alternate-background-color: #f7f4f6;
    border: 1px solid #d8cdd4;
    selection-background-color: #edbfd1;
    selection-color: #351521;
    padding: 4px;
}
QComboBox::drop-down {
    border: 0;
    width: 20px;
}
QHeaderView::section {
    background-color: #eee9ed;
    border: 0;
    border-right: 1px solid #d8cdd4;
    border-bottom: 1px solid #d8cdd4;
    padding: 5px 7px;
}

QPushButton {
    background-color: #f4e9ee;
    border: 1px solid #c9a8b6;
    padding: 5px 10px;
}
QPushButton:hover, QToolButton:hover {
    background-color: #f8e0ea;
}
QPushButton:pressed {
    background-color: #edbfd1;
}
QPushButton:disabled, QLineEdit:disabled {
    color: #71666d;
    background-color: #ece8eb;
    border-color: #d8cdd4;
}

QScrollBar:vertical {
    background: #f5f3f5;
    width: 11px;
    margin: 0;
}
QScrollBar:horizontal {
    background: #f5f3f5;
    height: 11px;
    margin: 0;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #b8aeb5;
    min-height: 24px;
    min-width: 24px;
}
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
    border: 0;
}

QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #ded8de;
}
QStatusBar::item {
    border: 0;
}

QLabel#assistantEyebrow {
    color: #63545d;
    font-weight: bold;
    letter-spacing: 1px;
}
QLabel#assistantStatus {
    color: #8e1747;
    border-bottom: 1px solid #d8cdd4;
    padding-bottom: 8px;
}
QLabel#assistantHistory {
    color: #574b52;
    border: 1px solid #d8cdd4;
    padding: 10px;
}
QLabel#assistantContext {
    color: #393139;
    background-color: #eee9ed;
    border: 1px solid #d8cdd4;
    padding: 8px;
}
QPushButton#assistantSend {
    color: #8e1747;
    border-color: #bc8099;
}
