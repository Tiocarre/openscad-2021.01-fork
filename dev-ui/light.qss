/* UI DEV PALETTE: edit these values; Qt tokens below are refreshed on save. */
/* @palette canvas=#f3f2ef */
/* @palette canvas-end=#ecebe8 */
/* @palette panel=#fefefe */
/* @palette panel-end=#f6f5f3 */
/* @palette surface=#ffffff */
/* @palette raised=#f2f1ef */
/* @palette input=#ffffff */
/* @palette text=#1e1e1e */
/* @palette muted=#55514f */
/* @palette disabled-text=#696461 */
/* @palette disabled-bg=#e9e8e5 */
/* @palette border=#cfceca */
/* @palette border-strong=#aaa8a3 */
/* @palette accent=#b13f91 */
/* @palette accent-strong=#963276 */
/* @palette accent-soft=#f4e2ee */
/* @palette accent-pressed=#e8c3dc */
/* @palette focus=#9c2f79 */
/* @palette selection=#edc9df */
/* @palette selection-text=#261722 */
/* @palette tooltip-bg=#fffefe */
/* @palette tooltip-text=#1e1e1e */
/* @palette assistant-status=#8f2c70 */
/* @palette assistant-secondary=#514c4f */
QWidget {
    color: @text@;
    font-family: "Cascadia Code", "Cascadia Mono", "Consolas", monospace;
    font-size: 9pt;
}
QLabel { background: transparent; }
QWidget:disabled { color: @disabled-text@; }

QMainWindow#MainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @canvas@, stop:1 @canvas-end@);
    border: 1px solid @border@;
}
QMainWindow#MainWindow > QWidget#centralwidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @canvas@, stop:1 @canvas-end@);
}
QWidget#mainWidget { background: transparent; }
QMainWindow::separator, QSplitter::handle {
    background: @border@;
    width: 2px;
    height: 2px;
}
QMainWindow::separator:hover, QSplitter::handle:hover { background: @accent-strong@; }

QMenuBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @panel@, stop:1 @panel-end@);
    border: 0;
    border-bottom: 1px solid @border@;
    padding: 2px 5px;
}
QMenuBar::item {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 5px 8px;
}
QMenuBar::item:selected, QMenuBar::item:pressed {
    background: @accent-soft@;
    border-color: @border-strong@;
    color: @text@;
}
QMenu {
    background: @surface@;
    color: @text@;
    border: 1px solid @border-strong@;
    border-radius: 2px;
    padding: 4px;
}
QMenu::item {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 5px 24px 5px 10px;
}
QMenu::item:selected, QMenu::item:pressed {
    background: @accent-soft@;
    border-color: @border@;
    color: @text@;
}
QMenu::item:disabled { color: @disabled-text@; }
QMenu::separator {
    height: 1px;
    background: @border@;
    margin: 4px 6px;
}

QToolBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @panel@, stop:1 @panel-end@);
    border: 0;
    border-bottom: 1px solid @border@;
    spacing: 3px;
    padding: 3px 4px;
}
QToolBar::separator {
    background: @border@;
    width: 1px;
    margin: 3px 5px;
}
QToolButton {
    background: transparent;
    color: @text@;
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 4px;
}
QToolButton:hover, QToolButton:checked {
    background: @accent-soft@;
    border-color: @border-strong@;
}
QToolButton:pressed { background: @accent-pressed@; }
QToolButton:focus { border: 1px solid @focus@; }
QToolButton:disabled { color: @disabled-text@; }

QDockWidget {
    background: @panel@;
    border: 1px solid @border@;
}
QDockWidget::title {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @panel-end@, stop:1 @panel@);
    color: @text@;
    border: 0;
    border-bottom: 1px solid @border@;
    padding: 6px 9px;
    text-align: left;
}
QDockWidget::close-button, QDockWidget::float-button {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 2px;
}
QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background: @accent-soft@;
    border-color: @border-strong@;
}

QTabBar::tab {
    background: @panel@;
    color: @muted@;
    border: 1px solid @border@;
    border-bottom-color: @border-strong@;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    padding: 6px 10px;
}
QTabBar::tab:hover { color: @text@; background: @surface@; }
QTabBar::tab:selected {
    background: @surface@;
    color: @text@;
    border-bottom-color: @accent@;
}
QTabBar::tab:focus { border-top-color: @focus@; }

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox,
QPlainTextEdit, QTextEdit, QTextBrowser,
QListWidget, QTreeWidget, QTableWidget, QTableView {
    background: @input@;
    alternate-background-color: @surface@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 2px;
    selection-background-color: @selection@;
    selection-color: @selection-text@;
    padding: 4px 6px;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover,
QPlainTextEdit:hover, QTextEdit:hover, QTextBrowser:hover,
QListWidget:hover, QTreeWidget:hover, QTableWidget:hover, QTableView:hover {
    border-color: @border-strong@;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QPlainTextEdit:focus, QTextEdit:focus, QTextBrowser:focus,
QListWidget:focus, QTreeWidget:focus, QTableWidget:focus, QTableView:focus {
    border-color: @focus@;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled,
QPlainTextEdit:disabled, QTextEdit:disabled {
    background: @disabled-bg@;
    color: @disabled-text@;
    border-color: @border@;
}
QComboBox::drop-down, QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background: transparent;
    border: 0;
    width: 20px;
}
QComboBox QAbstractItemView {
    background: @surface@;
    color: @text@;
    border: 1px solid @border-strong@;
    selection-background-color: @selection@;
    selection-color: @selection-text@;
    outline: 0;
}
QAbstractItemView::item { padding: 5px 8px; }
QAbstractItemView::item:hover { background: @accent-soft@; color: @text@; }
QAbstractItemView::item:selected {
    background: @selection@;
    color: @selection-text@;
}
QHeaderView::section {
    background: @panel@;
    color: @muted@;
    border: 0;
    border-right: 1px solid @border@;
    border-bottom: 1px solid @border@;
    padding: 5px 8px;
}

QPushButton {
    background: @raised@;
    color: @text@;
    border: 1px solid @border-strong@;
    border-radius: 2px;
    padding: 4px 9px;
}
QPushButton:hover { background: @accent-soft@; border-color: @accent-strong@; }
QPushButton:pressed { background: @accent-pressed@; border-color: @accent@; }
QPushButton:checked { background: @accent-soft@; border-color: @accent@; }
QPushButton:focus { border-color: @focus@; }
QPushButton:disabled {
    background: @disabled-bg@;
    color: @disabled-text@;
    border-color: @border@;
}
QCheckBox, QRadioButton { spacing: 6px; color: @text@; }
QCheckBox:disabled, QRadioButton:disabled { color: @disabled-text@; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    background: @input@;
    border: 1px solid @border-strong@;
    border-radius: 2px;
}
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: @accent@; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: @accent-strong@;
    border-color: @accent@;
}

QGroupBox {
    background: transparent;
    border: 1px solid @border@;
    border-radius: 2px;
    margin-top: 10px;
    padding: 8px 6px 6px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 9px;
    padding: 0 4px;
    color: @muted@;
}

QScrollBar:vertical { background: @panel@; width: 11px; margin: 2px; }
QScrollBar:horizontal { background: @panel@; height: 11px; margin: 2px; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: @border-strong@;
    border-radius: 2px;
    min-height: 24px;
    min-width: 24px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: @accent-strong@; }
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; border: 0; }

QProgressBar {
    background: @input@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 2px;
    text-align: center;
}
QProgressBar::chunk { background: @accent-strong@; border-radius: 2px; }
QStatusBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @panel@, stop:1 @panel-end@);
    color: @muted@;
    border-top: 1px solid @border@;
}
QStatusBar::item { border: 0; }
QToolTip {
    background: @tooltip-bg@;
    color: @tooltip-text@;
    border: 1px solid @border-strong@;
    border-radius: 2px;
    padding: 5px 8px;
}

QWidget#assistantPanel { background: @panel@; }
QLabel#assistantEyebrow {
    color: @muted@;
    font-weight: bold;
    letter-spacing: 1px;
}
QLabel#assistantStatus {
    color: @assistant-status@;
    border-bottom: 1px solid @border@;
    padding-bottom: 8px;
}
QLabel#assistantHistory {
    background: @input@;
    color: @assistant-secondary@;
    border: 1px solid @border@;
    border-radius: 2px;
    padding: 10px;
}
QLabel#assistantContext {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 2px;
    padding: 8px;
}
QLineEdit#assistantPrompt { background: @input@; }
QPushButton#assistantSend {
    color: @text@;
    border-color: @accent-strong@;
}

/* Compact technical defaults and states shared by both UI themes. */
QToolTip, QWhatsThis { font-family: "Cascadia Code", "Consolas", monospace; font-size: 9pt; }
QTextBrowser a { color: @accent-strong@; }
QTextBrowser a:hover { color: @focus@; }
QAbstractItemView, QCompleter QAbstractItemView {
    background: @surface@;
    color: @text@;
    border: 1px solid @border-strong@;
    selection-background-color: @selection@;
    selection-color: @selection-text@;
}
QListView::item, QTreeView::item, QTableView::item,
QListWidget::item, QTreeWidget::item, QTableWidget::item { padding: 3px 6px; }
QListView::item:hover, QTreeView::item:hover, QTableView::item:hover,
QListWidget::item:hover, QTreeWidget::item:hover, QTableWidget::item:hover {
    background: @accent-soft@;
    color: @text@;
}
QComboBox QAbstractItemView::item:selected,
QListView::item:selected, QTreeView::item:selected, QTableView::item:selected,
QListWidget::item:selected, QTreeWidget::item:selected, QTableWidget::item:selected {
    background: @selection@;
    color: @selection-text@;
}
QTabWidget::pane { border: 1px solid @border@; background: @panel@; }
QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled,
QListView:disabled, QTreeView:disabled, QTableView:disabled { background: @disabled-bg@; color: @disabled-text@; }
QMenu::indicator { width: 12px; height: 12px; }
QMenu::item:checked { background: @accent-soft@; color: @text@; }
QToolButton:checked, QToolButton:pressed { color: @text@; }
QPushButton:default { border-color: @accent-strong@; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { border-radius: 2px; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: @accent-strong@; }
QHeaderView::section:hover { color: @text@; background: @raised@; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QPlainTextEdit:focus, QTextEdit:focus, QTextBrowser:focus { border: 1px solid @focus@; }
